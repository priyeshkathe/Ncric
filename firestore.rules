rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Help Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(resource) {
      return isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() < 128;
    }

    // Tournament Validation
    function isValidTournament(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.creatorId == request.auth.uid &&
             data.status in ['configuring', 'live', 'completed'];
    }

    match /tournaments/{tournamentId} {
      // allow get: Single document fetch
      allow get: if (resource.data.isPublic == true) || isOwner(resource);

      // allow list: For queries (collection-wide)
      // Note: resource.data refers to each document in the potential result set
      allow list: if (resource.data.isPublic == true) || isOwner(resource);
      
      allow create: if isSignedIn() && 
                    isValidId(tournamentId) && 
                    isValidTournament(request.resource.data);
      
      allow update: if isOwner(resource) && 
                    isValidTournament(request.resource.data) &&
                    request.resource.data.creatorId == resource.data.creatorId;
      
      allow delete: if isOwner(resource);
    }
  }
}
