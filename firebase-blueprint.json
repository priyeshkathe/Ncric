{
  "entities": {
    "tournament": {
      "title": "Tournament",
      "description": "A cricket tournament tournament",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["configuring", "live", "completed"] },
        "teamsCount": { "type": "number" },
        "playoffs": {
           "type": "object",
           "properties": {
             "champion": { "type": "string" }
           }
        }
      },
      "required": ["name", "creatorId", "status"]
    },
    "team": {
      "title": "Team",
      "description": "A team in a tournament",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "players": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name"]
    },
    "match": {
      "title": "Match",
      "description": "A match in a tournament",
      "type": "object",
      "properties": {
        "team1": { "type": "string" },
        "team2": { "type": "string" },
        "team1Score": { "type": "number" },
        "team2Score": { "type": "number" },
        "team1Wickets": { "type": "number" },
        "team2Wickets": { "type": "number" },
        "team1Overs": { "type": "number" },
        "team2Overs": { "type": "number" },
        "quota": { "type": "number" },
        "status": { "type": "string", "enum": ["upcoming", "completed"] },
        "winner": { "type": "string" },
        "type": { "type": "string", "enum": ["league", "semi-final", "final"] },
        "playerPerformances": { "type": "object" }
      },
      "required": ["team1", "team2", "status", "type"]
    }
  },
  "firestore": {
    "/tournaments/{tournamentId}": {
      "schema": "tournament",
      "description": "Root tournament document"
    },
    "/tournaments/{tournamentId}/teams/{teamId}": {
      "schema": "team",
      "description": "Teams within the tournament"
    },
    "/tournaments/{tournamentId}/matches/{matchId}": {
      "schema": "match",
      "description": "Matches within the tournament"
    }
  }
}
